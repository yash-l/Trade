<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/hydra_bg" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:padding="18dp" android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/title" android:text="HYDRA Ω-APEX" android:textColor="@color/hydra_text" android:textStyle="bold" android:textSize="21sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/mode" android:text="PAPER" android:textColor="@color/hydra_accent" android:textStyle="bold" android:padding="10dp" android:background="#18352F" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:padding="8dp" android:orientation="horizontal" android:background="@color/hydra_panel" android:layout_width="match_parent" android:layout_height="64dp">
        <Button android:id="@+id/home" android:text="HOME" android:textSize="10sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/apex" android:text="APEX" android:textSize="10sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/trades" android:text="TRADES" android:textSize="10sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/broker" android:text="BROKER" android:textSize="10sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/settings" android:text="SETTINGS" android:textSize="10sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
