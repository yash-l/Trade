# HYDRA default is PAPER. Missing LIVE settings never imply LIVE.
HYDRA_MODE=paper
HYDRA_DATA_MODE=demo
HYDRA_HOST=127.0.0.1
HYDRA_PORT=8181
HYDRA_CAPITAL=15000
HYDRA_NORMAL_RISK=275
HYDRA_HARD_RISK=375
HYDRA_DAILY_LOSS=600
HYDRA_MAX_TRADES=2
HYDRA_SCORE_THRESHOLD=85
HYDRA_LOT_SIZE=65
HYDRA_MAX_CAPITAL_PER_TRADE=8000
HYDRA_MAX_SPREAD_PCT=1.0
HYDRA_PREFERRED_SPREAD_PCT=0.5
HYDRA_MAX_PRICE_DRIFT_PCT=1.5
HYDRA_MAX_QUOTE_AGE_SEC=3.0
HYDRA_DB_PATH=data/hydra.sqlite3

# 5paisa/XStream - required only when HYDRA_DATA_MODE=5paisa.
HYDRA_5PAISA_APP_KEY=
HYDRA_5PAISA_USER_ID=
HYDRA_5PAISA_ENCRYPTION_KEY=
HYDRA_5PAISA_ACCESS_TOKEN=
HYDRA_5PAISA_CLIENT_CODE=
# NIFTY ScripCode may be left blank/0: v2.2.1 attempts auto-resolution from Scrip Master.
HYDRA_5PAISA_NIFTY_SCRIP_CODE=0
HYDRA_5PAISA_NIFTY_EXCH_TYPE=C
HYDRA_5PAISA_NIFTY_SYMBOL=NIFTY
HYDRA_5PAISA_OPTION_STRIKE_STEP=50
# Normal APEX avoids 0-1 DTE; nearest expiry with >=2 DTE is preferred.
HYDRA_5PAISA_MIN_DTE=2
HYDRA_5PAISA_SCRIP_MASTER_URL=https://Openapi.5paisa.com/VendorsAPI/Service1.svc/ScripMaster/segment/All

# LIVE execution is deliberately difficult to arm.
HYDRA_LIVE_ENABLED=false
HYDRA_LIVE_CONFIRM=
HYDRA_STATIC_IP_CONFIRMED=false
HYDRA_ALGO_ID=0

# Position management (R = initial underlying risk distance)
HYDRA_BREAKEVEN_TRIGGER_R=1.0
HYDRA_BREAKEVEN_LOCK_R=0.05
HYDRA_TRAILING_STOP_TRIGGER_R=1.4
HYDRA_TRAILING_STOP_BUFFER_R=0.10
HYDRA_TRAILING_TARGET_TRIGGER_R=1.6
HYDRA_TRAILING_TARGET_GAP_R=0.75
HYDRA_TRAILING_TARGET_STEP_R=0.25
HYDRA_MAX_TARGET_R=4.0

# Adaptive trailing tuner: shadow-only by default.
HYDRA_ADAPTIVE_TRAIL_SHADOW_ONLY=true
